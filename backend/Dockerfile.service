FROM maven:3.9.11-eclipse-temurin-21-alpine AS build
WORKDIR /workspace
ARG SERVICE
COPY pom.xml .
COPY common-lib/pom.xml common-lib/pom.xml
COPY api-gateway/pom.xml api-gateway/pom.xml
COPY identity-service/pom.xml identity-service/pom.xml
COPY social-service/pom.xml social-service/pom.xml
COPY post-service/pom.xml post-service/pom.xml
COPY notification-service/pom.xml notification-service/pom.xml
COPY chat-service/pom.xml chat-service/pom.xml
COPY ai-service/pom.xml ai-service/pom.xml
COPY moderation-service/pom.xml moderation-service/pom.xml
COPY common-lib/src common-lib/src
COPY ${SERVICE}/src ${SERVICE}/src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -q -pl ${SERVICE} -am -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
ARG SERVICE
COPY --from=build /workspace/${SERVICE}/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
