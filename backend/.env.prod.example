SPRING_PROFILES_ACTIVE=prod
GATEWAY_PUBLIC_URL=https://api.example.com
POSTGRES_DB=social_media_ai_db
POSTGRES_USER=<set-in-secret-manager>
POSTGRES_PASSWORD=<set-in-secret-manager>
JWT_SECRET=<set-in-secret-manager>
INTERNAL_API_KEY=<set-in-secret-manager>
GOOGLE_CLIENT_ID=<set-in-secret-manager>
OTP_EXPOSE_CODE=false
MINIO_ROOT_USER=<set-in-secret-manager>
MINIO_ROOT_PASSWORD=<set-in-secret-manager>
ADMIN_USERNAME=<set-in-secret-manager>
ADMIN_PASSWORD=<set-in-secret-manager>

# Subscription sandbox: configure the HTTPS ingress, never expose the signing secret.
SANDBOX_CHECKOUT_BASE_URL=https://sandbox.example.invalid/api/v1/payments/sandbox/checkouts
PAYMENT_WEBHOOK_SECRET=<production-sandbox-signing-secret-at-least-32-bytes>
SUBSCRIPTION_DB_PASSWORD=<production-subscription-db-password>
PAYMENT_SANDBOX_ENABLED=false
