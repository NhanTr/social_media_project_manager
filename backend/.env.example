SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=social_media_ai_db
POSTGRES_USER=<local-postgres-user>
POSTGRES_PASSWORD=<local-postgres-password>
JWT_SECRET=<local-jwt-secret-at-least-32-bytes>
INTERNAL_API_KEY=<local-internal-api-key>
GOOGLE_CLIENT_ID=
OTP_EXPOSE_CODE=true
MINIO_ROOT_USER=<local-minio-user>
MINIO_ROOT_PASSWORD=<local-minio-password>
ADMIN_USERNAME=<local-admin-user>
ADMIN_PASSWORD=<local-admin-password>

# Subscription sandbox: configure the HTTPS ingress, never expose the signing secret.
SANDBOX_CHECKOUT_BASE_URL=https://sandbox.example.invalid/api/v1/payments/sandbox/checkouts
PAYMENT_WEBHOOK_SECRET=<local-sandbox-signing-secret-at-least-32-bytes>
SUBSCRIPTION_DB_PASSWORD=<local-subscription-db-password>
PAYMENT_SANDBOX_ENABLED=true
